# PostgreSQL
POSTGRES_DB=recruitment
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-openssl-rand

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-openssl-rand
MINIO_BUCKET=resumes
MINIO_INTERNAL_URL=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000

# Auth (JWT) — required; generate with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
# COOKIE_SECURE=true  # uncomment in production (requires HTTPS)
# ALLOWED_ORIGINS=https://yourdomain.com  # comma-separated; overrides default localhost list

# Dev-only helpers used by scripts/ (login via /auth/login to obtain JWT)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-me

# ── LLM provider ─────────────────────────────────────────────────────────────
# Switch between "openai" (dev) and "ollama" (prod) with no code change.
# Dev default: openai — fast iteration on a laptop without a GPU.
# Prod default: ollama — keeps all inference on-prem; requires a GPU host.
#
# !! GUARDRAIL !! Dev/OpenAI path must only ever process SYNTHETIC resumes
# (generated by scripts/generate_*_resumes.py).  NEVER feed real candidate
# PII to OpenAI until a Data Processing Agreement (DPA) with OpenAI is in
# place and approved by Legal.
LLM_PROVIDER=openai
LLM_TIMEOUT_SECONDS=180

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-replace-with-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Ollama (used when LLM_PROVIDER=ollama — set OLLAMA_BASE_URL to the host running Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Redis + Celery worker
REDIS_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=true   # uncomment to run tasks inline (dev/test only)

# Email (SMTP) — leave SMTP_HOST unset to use log-only stub in development
#
# Gmail option (requires Google 2FA + App Password):
#   1. Enable 2FA: https://myaccount.google.com/security
#   2. Create App Password: https://myaccount.google.com/apppasswords
#      Category: Mail / Other → copy the 16-char password (spaces optional)
#   3. Fill in below — use your full Gmail address for both USER and FROM
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=you@gmail.com
# SMTP_USE_TLS=true
# APP_BASE_URL=https://ai-based-recruitment-eight.vercel.app  # production; set to http://localhost:3000 for dev

# Slack / Teams webhook URLs (optional — daily summary + SLA alerts)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# Audit log retention (both audit_log and business_events tables)
AUDIT_RETENTION_MONTHS=12
# Comma-separated IPs of trusted reverse proxies that may set X-Forwarded-For
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2

# Frontend (Vite) — all APIs served from single monolith on port 8000
VITE_API_BASE=http://localhost:8000

ELASTICSEARCH_URL=http://localhost:9200
