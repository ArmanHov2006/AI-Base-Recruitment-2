# Copy this to .env.prod and fill in real values before deploying.
# Generate secrets with: openssl rand -hex 32

# ── Domain ───────────────────────────────────────────────────────────────────
APP_DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com          # Let's Encrypt notifications

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=recruitment
POSTGRES_USER=recruitment_user
POSTGRES_PASSWORD=REPLACE_openssl_rand_hex_32

# ── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=REPLACE_openssl_rand_hex_16
MINIO_ROOT_PASSWORD=REPLACE_openssl_rand_hex_32
MINIO_BUCKET=resumes
MINIO_PUBLIC_URL=https://yourdomain.com  # or a separate minio subdomain

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_openssl_rand_hex_32   # REQUIRED — app refuses to start without this
COOKIE_SECURE=true

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=REPLACE_your_sendgrid_api_key
SMTP_FROM=noreply@yourdomain.com
APP_BASE_URL=https://yourdomain.com

# ── LLM provider ─────────────────────────────────────────────────────────────
# Prod uses Ollama (on-prem, GPU host required — see §7 external blockers in
# docs/PRD-scope-finalization.md).  Set LLM_PROVIDER=openai only in dev.
#
# !! GUARDRAIL !! OpenAI path must only ever process SYNTHETIC resumes
# (scripts/generate_*_resumes.py).  NEVER route real candidate PII to OpenAI
# until a Data Processing Agreement (DPA) with OpenAI is approved by Legal.
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=300

# Ollama (used when LLM_PROVIDER=ollama — point to the GPU host running Ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI (leave unset in prod; fill only if temporarily switching for dev/testing)
# OPENAI_API_KEY=REPLACE_your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ── MinIO internal URL ────────────────────────────────────────────────────────
# Internal URL used by the API/worker to reach MinIO (not the public-facing URL).
MINIO_INTERNAL_URL=http://minio:9000

# ── Redis + Celery worker ────────────────────────────────────────────────────
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PASSWORD=REPLACE_openssl_rand_hex_32

# ── Webhooks (optional) ───────────────────────────────────────────────────────
# Leave empty to disable. Sends stage change / rating notifications to Slack/Teams.
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_PASSWORD=REPLACE_openssl_rand_hex_32

# ── Trusted proxies (optional) ────────────────────────────────────────────────
# Comma-separated list of reverse-proxy IPs allowed to set X-Forwarded-For.
# Leave empty to trust the direct peer only.
TRUSTED_PROXIES=
